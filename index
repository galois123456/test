<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supabase + Vercel 연동 테스트</title>
    <!-- Supabase 라이브러리 불러오기 -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        body { font-family: 'Malgun Gothic', sans-serif; padding: 20px; max-width: 600px; margin: 0 auto; }
        .section { background: #f5f5f5; padding: 20px; margin-bottom: 20px; border-radius: 8px; }
        input { padding: 8px; margin-bottom: 10px; width: calc(100% - 20px); }
        button { padding: 10px 15px; cursor: pointer; background: #0070f3; color: white; border: none; border-radius: 4px; margin-right: 5px; }
        button:hover { background: #005bb5; }
    </style>
</head>
<body>

    <h1>🚀 내 웹앱 배포 테스트</h1>

    <!-- 로그인/회원가입 섹션 -->
    <div class="section">
        <h2>1. 로그인 테스트 (Auth)</h2>
        <input type="email" id="email" placeholder="이메일 주소">
        <input type="password" id="password" placeholder="비밀번호 (6자리 이상)">
        <button onclick="signUp()">회원가입</button>
        <button onclick="signIn()">로그인</button>
        <button onclick="signOut()" style="background: #333;">로그아웃</button>
        <p id="auth-status" style="font-weight: bold; color: green;">상태: 로그아웃 됨</p>
    </div>

    <!-- 데이터베이스 섹션 -->
    <div class="section">
        <h2>2. 데이터 저장 테스트 (Database)</h2>
        <p>※ Supabase에 'messages'라는 테이블과 'content'라는 텍스트 컬럼이 있어야 작동합니다.</p>
        <input type="text" id="memo" placeholder="저장할 메모 입력">
        <button onclick="saveData()">저장하기</button>
        <button onclick="loadData()">불러오기</button>
        <ul id="memo-list"></ul>
    </div>

    <script>
        // ★ 중요: Supabase 대시보드에서 Project URL과 anon public 키를 복사해서 아래에 붙여넣으세요!
        const SUPABASE_URL = 'https://본인의_프로젝트_주소.supabase.co';
        const SUPABASE_KEY = '본인의_ANON_KEY';
        
        // Supabase 초기화
        const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        // 1. 회원가입 기능
        async function signUp() {
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const { data, error } = await supabase.auth.signUp({ email, password });
            
            if (error) alert("회원가입 에러: " + error.message);
            else alert("회원가입 성공! (이메일 인증을 껐다면 바로 로그인 가능합니다)");
        }

        // 2. 로그인 기능
        async function signIn() {
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const { data, error } = await supabase.auth.signInWithPassword({ email, password });
            
            if (error) {
                alert("로그인 에러: " + error.message);
            } else {
                document.getElementById('auth-status').innerText = `상태: 로그인 됨 (${data.user.email})`;
            }
        }

        // 3. 로그아웃 기능
        async function signOut() {
            const { error } = await supabase.auth.signOut();
            if (error) alert("로그아웃 에러: " + error.message);
            else document.getElementById('auth-status').innerText = "상태: 로그아웃 됨";
        }

        // 4. 데이터 저장 기능 (messages 테이블에 저장)
        async function saveData() {
            const memoContent = document.getElementById('memo').value;
            const { data, error } = await supabase
                .from('messages') // 테이블 이름
                .insert([ { content: memoContent } ]);
            
            if (error) alert("저장 에러: " + error.message);
            else {
                alert("저장 완료!");
                document.getElementById('memo').value = '';
                loadData(); // 저장 후 목록 새로고침
            }
        }

        // 5. 데이터 불러오기 기능
        async function loadData() {
            const { data, error } = await supabase
                .from('messages')
                .select('*');
                
            if (error) {
                alert("불러오기 에러: " + error.message);
                return;
            }

            const list = document.getElementById('memo-list');
            list.innerHTML = ''; // 기존 목록 초기화
            data.forEach(item => {
                const li = document.createElement('li');
                li.innerText = item.content;
                list.appendChild(li);
            });
        }
    </script>
</body>
</html>
